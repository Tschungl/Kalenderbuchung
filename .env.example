# Datenbank (bei docker compose automatisch gesetzt)
DATABASE_URL=postgresql://kalender:kalender@localhost:5432/kalender

# Öffentliche Adresse der App
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
# Zufälliger Schlüssel: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (Google Cloud Console -> APIs & Dienste -> Anmeldedaten)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft 365 / Outlook (optional; ohne ID wird nur Google angeboten)
# Azure Portal -> App-Registrierungen, siehe README "Microsoft einrichten"
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Standard "common" = alle Firmen- und Privatkonten
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Zoom (optional, siehe README): Gastgeber verbinden ihr Zoom-Konto im Dashboard
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Demo-Modus ohne echten Kalender (nur für Vorführungen): simulierte belegte Zeiten
DEMO_CALENDAR=

# E-Mail (optional; ohne SMTP_HOST werden Mails nur geloggt)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=termine@example.com

# KI-Terminverhandlung (Claude API). Ohne Schlüssel ist die Funktion ausgeblendet.
ANTHROPIC_API_KEY=
# Optional anderes Modell, Standard: claude-opus-5-5
NEGOTIATION_MODEL=

# Erinnerungsmails laufen automatisch im App-Prozess (minütlich).
# Bei mehreren App-Instanzen: DISABLE_REMINDER_LOOP=1 setzen und stattdessen
# POST /api/cron/reminders mit "Authorization: Bearer <CRON_SECRET>" per Cron aufrufen.
DISABLE_REMINDER_LOOP=
CRON_SECRET=

# Reverse Proxy (docker compose --profile proxy): Hauptdomain und Mail für Let's Encrypt
APP_DOMAIN=termine.example.com
ACME_EMAIL=admin@example.com
