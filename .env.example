# Datenbank (bei docker compose automatisch gesetzt)
DATABASE_URL=postgresql://kalender:kalender@localhost:5432/kalender

# Öffentliche Adresse der App
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
# Zufälliger Schlüssel: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (Google Cloud Console -> APIs & Dienste -> Anmeldedaten)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# E-Mail (optional; ohne SMTP_HOST werden Mails nur geloggt)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=termine@example.com

# KI-Terminverhandlung (Claude API). Ohne Schlüssel ist die Funktion ausgeblendet.
ANTHROPIC_API_KEY=
# Optional anderes Modell, Standard: claude-opus-5-5
NEGOTIATION_MODEL=
